---
// Eyebrow + H1 + "Copy page" + lede (the page's `description`), as on the reference.
// "Copy page" copies the page's Markdown source, which is embedded at build time.
const PAGE_TITLE_ID = '_top'; // Starlight's skip-link target (not exported)
const route = Astro.locals.starlightRoute;
const { title, description, eyebrow } = route.entry.data as any;
const body = route.entry.body ?? '';
const isNotFound = route.id === '404' || route.entry.id === '404';
const md = `# ${title}\n\n${description ? description + '\n\n' : ''}${body.trim()}\n`;
---

<div class="p-title">
	{eyebrow && <p class="p-eyebrow">{eyebrow}</p>}
	<div class="p-title-row">
		<h1 id={PAGE_TITLE_ID}>{title}</h1>
		{!isNotFound && <button class="p-copy print:hidden" data-pagefind-ignore type="button" data-md={md} aria-label="Copy this page as Markdown">
			<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
				<rect x="5.5" y="5.5" width="8" height="8" rx="1.8" /><path d="M10.5 5.5V4.3a1.8 1.8 0 0 0-1.8-1.8H4.3a1.8 1.8 0 0 0-1.8 1.8v4.4a1.8 1.8 0 0 0 1.8 1.8h1.2" />
			</svg>
			<span>Copy page</span>
		</button>}
	</div>
	{description && <p class="p-lede">{description}</p>}
</div>

<script>
	document.querySelectorAll<HTMLButtonElement>('.p-copy').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const label = btn.querySelector('span')!;
			try {
				await navigator.clipboard.writeText(btn.dataset.md || '');
				label.textContent = 'Copied';
			} catch {
				label.textContent = 'Copy failed';
			}
			setTimeout(() => (label.textContent = 'Copy page'), 1600);
		});
	});
</script>

<style>
	.p-title { margin-top: 8px; }
	.p-eyebrow {
		margin: 0 0 8px;
		font: 500 13px/1.4 var(--__sl-font);
		color: var(--p-ink-4);
	}
	.p-title-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 16px;
	}
	h1 {
		margin: 0;
		font-family: var(--p-display);
		font-weight: 400;
		font-size: 36px;
		line-height: 1.1;
		letter-spacing: -0.025em;
		color: var(--p-ink);
	}
	.p-copy {
		flex: 0 0 auto;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 32px;
		margin-top: 2px;
		padding: 0 12px;
		border: 0;
		border-radius: 8px;
		background: var(--p-card);
		box-shadow: inset 0 0 0 1px var(--p-control);
		color: var(--p-ink-2);
		font: 500 13px/1 var(--__sl-font);
		cursor: pointer;
		transition: background-color 0.15s var(--p-ease), box-shadow 0.15s var(--p-ease), transform 0.12s var(--p-ease);
	}
	.p-copy:hover { background: var(--p-bg-2); box-shadow: inset 0 0 0 1px var(--p-ink-4); color: var(--p-ink); }
	.p-copy:active { transform: scale(0.98); }
	.p-copy:focus-visible { outline: 2px solid var(--p-blue); outline-offset: 2px; }
	.p-lede {
		margin: 14px 0 0;
		max-width: 36em;
		font-size: 18px;
		line-height: 1.55;
		letter-spacing: -0.005em;
		color: var(--p-lede);
		text-wrap: pretty;
	}
	@media (max-width: 50rem) {
		h1 { font-size: 30px; }
		.p-lede { font-size: 17px; margin-top: 10px; }
		.p-copy span { display: none; }
		.p-copy { width: 40px; height: 40px; margin-top: -4px; padding: 0; justify-content: center; background: transparent; box-shadow: inset 0 0 0 1px var(--p-rule); color: var(--p-ink-3); }
	}
</style>
